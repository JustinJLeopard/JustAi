# ManusLocal Environment Configuration — EXAMPLE
# Copy to .env and fill in your values: cp .env.example .env

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://WINDOWS_HOST_IP:11434
OLLAMA_MODEL=qwen3:30b-a3b-q4_K_M

# ── LiteLLM Proxy ─────────────────────────────────────────────────────────────
LITELLM_KEY=sk-litellm-your-key-here
OPENAI_API_KEY=sk-gameron-your-key-here
OPENAI_BASE_URL=https://api.gameron.me/v1

# ── GitHub (for OpenHands MCP) ────────────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here

# ── Honcho Memory ─────────────────────────────────────────────────────────────
HONCHO_API_KEY=hch-v3-your-key-here
HONCHO_BASE_URL=https://api.honcho.dev

# ── OpenRouter (for mini-swe-agent) ───────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Anthropic (optional direct usage) ─────────────────────────────────────────
# Only required for direct Anthropic calls outside the Gameron OpenAI-compatible path
ANTHROPIC_API_KEY=

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ── Cloud Manus Delegation ────────────────────────────────────────────────────
MANUS_API_URL=
MANUS_API_KEY=

# ── LocalManus Agent Routing ──────────────────────────────────────────────────
MANUSLOCAL_AGENT=assistant
MANUSLOCAL_DYNAMIC_MODEL=1
MANUSLOCAL_PRIMARY_MODEL=gpt-5.4
MANUSLOCAL_CODE_MODEL=gpt-5.3-codex
MANUSLOCAL_DEEP_REASONING_MODEL=claude-opus-4-6
MANUSLOCAL_REVERT_PRIMARY_MODEL=1
AGENT_INBOX_DIR=~/.agent-inbox

# ── Manus Hand Relay ──────────────────────────────────────────────────────────
MANUS_HAND_RELAY=https://manus-hand-relay.justinleopard.workers.dev
MANUS_HAND_TOKEN=your-token-here

# ── Free-tier API Keys ────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key
DEEPSEEK_API_KEY=your-deepseek-key
