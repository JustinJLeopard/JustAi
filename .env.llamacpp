# JustAi — llama.cpp (local) profile
# Points the judging/planning stages at the local llama.cpp server
# (llama-server, OpenAI-compatible) instead of the legacy LiteLLM :4000 proxy.
#
# Usage:  set -a; . ./.env.llamacpp; set +a      (or: cp .env.llamacpp .env)
# Backend: llama-server @ 127.0.0.1:8085 (Qwen3-VL-8B-Instruct). It accepts any
# model string, so the names below are clean aliases.

LITELLM_BASE_URL=http://127.0.0.1:8085
LITELLM_KEY=sk-local            # llama.cpp ignores auth; kept non-empty for key-presence checks

# --- Judging / planning stages -> local Qwen (verified working) ---
JUSTAI_INTENT_MODEL=qwen3-vl-8b
JUSTAI_PLANNER_MODEL=qwen3-vl-8b
JUSTAI_REVIEWER_MODEL=qwen3-vl-8b
JUSTAI_FIDELITY_MODEL=qwen3-vl-8b
JUSTAI_ANALYSIS_MODEL=qwen3-vl-8b
JUSTAI_INTENT_BAR=90            # intent-fidelity "A" bar

# --- Executor (mini-swe-agent bash/coding) ---
# HYBRID INTENT: the executor should run a STRONGER coder than the 8B judge.
# Under this config-only profile the executor shares LITELLM_BASE_URL, so today
# it also hits 8085 (Qwen 8B) -- fine to smoke the pipeline, weak for real
# coding. To COMPLETE the hybrid, give the executor its own endpoint/model:
#   * stand up a coder on a second llama-server (e.g. Qwen2.5/3-Coder), and
#   * point the executor at it via JUSTAI_EXECUTOR_BASE_URL / JUSTAI_MINI_MODEL
#     (needs a small agent_dispatch addition -- see PR description).
JUSTAI_MINI_MODEL=qwen3-vl-8b
JUSTAI_ESCALATION_MODEL=qwen3-vl-8b

# --- Local services / misc (from .env.example) ---
JUSTAI_MCP_URL=http://127.0.0.1:3100
JUSTAI_SESSION_REF=sprint-5
JUSTAI_SAFE_MINI_MODE=stub
JUSTAI_RUNTIME_ROOT=/tmp/justai
