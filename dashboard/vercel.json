{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/demo.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    }
  ]
}
