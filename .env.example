# ──────────────────────────────────────────────────────────────────────────────
# JustAi Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in your keys:  cp .env.example .env
# These are loaded by justai/__init__.py on import.

# ── Model Routing ────────────────────────────────────────────────────────────
# LOCAL (llama.cpp) is the current stack: a ready-to-use profile lives in
# .env.llamacpp  ->  cp .env.llamacpp .env   (points every stage at llama-server
# @ 127.0.0.1:8085, Qwen3-VL-8B). The LiteLLM :4000 values below are the LEGACY
# cloud-proxy routing, kept for reference / cloud fallback.
LITELLM_BASE_URL=http://localhost:4000       # legacy LiteLLM proxy (local: see .env.llamacpp)
LITELLM_KEY=sk-justai

# Model selection for each pipeline stage (legacy cloud names; local uses qwen3-vl-8b)
JUSTAI_INTENT_MODEL=openai/claude-opus-4-6
JUSTAI_PLANNER_MODEL=openai/claude-opus-4-6
JUSTAI_REVIEWER_MODEL=openai/claude-opus-4-6
JUSTAI_FIDELITY_MODEL=openai/claude-opus-4-6

# ── Memory (claude-flow MCP) ────────────────────────────────────────────────
JUSTAI_MCP_URL=http://127.0.0.1:3100

# ── Session ──────────────────────────────────────────────────────────────────
JUSTAI_SESSION_REF=sprint-5

# ── safe-mini Boundary ──────────────────────────────────────────────────────
JUSTAI_SAFE_MINI_MODE=stub
JUSTAI_RUNTIME_ROOT=/tmp/justai

# ── Observability (LangFuse — optional) ──────────────────────────────────────
# Uncomment and fill to enable LLM tracing in the dashboard
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── API Keys (fill in yours) ────────────────────────────────────────────────
# GAMERON_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
