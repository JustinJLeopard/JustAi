# ──────────────────────────────────────────────────────────────────────────────
# JustAi Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in your keys:  cp .env.example .env
# These are loaded by justai/__init__.py on import.

# ── Model Routing (LiteLLM) ─────────────────────────────────────────────────
LITELLM_BASE_URL=http://localhost:4000
LITELLM_KEY=sk-justai

# Model selection for each pipeline stage
JUSTAI_INTENT_MODEL=openai/claude-opus-4-6
JUSTAI_PLANNER_MODEL=openai/claude-opus-4-6
JUSTAI_REVIEWER_MODEL=openai/claude-opus-4-6

# ── Memory (claude-flow MCP) ────────────────────────────────────────────────
JUSTAI_MCP_URL=http://127.0.0.1:3100

# ── Session ──────────────────────────────────────────────────────────────────
JUSTAI_SESSION_REF=sprint-5

# ── Delegation (relay + SpacetimeDB) ─────────────────────────────────────────
RELAY_DB_NAME=relay-room-dev
RELAY_SERVER=local-server
JUSTAI_DELEGATE_AGENT=manuslocal

# ── Observability (LangFuse — optional) ──────────────────────────────────────
# Uncomment and fill to enable LLM tracing in the dashboard
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── API Keys (fill in yours) ────────────────────────────────────────────────
# GAMERON_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
